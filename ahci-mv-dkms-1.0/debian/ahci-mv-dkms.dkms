PACKAGE_NAME="ahci-mv"
PACKAGE_VERSION="#MODULE_VERSION#"

# Take ahci.c and ahci.h from Debian's own linux-source package for the kernel
# being built, then apply the fix.  That way the private header ahci.h matches
# the one Debian's libahci.ko was built against, and only ahci.ko needs to be
# replaced.
PRE_BUILD="prepare.sh $kernelver"

# Once a kernel carries the fix itself, building this module for it is
# pointless.  dkms.conf is sourced as a shell script with $kernelver set, so
# the decision can be made per kernel here.  Setting the maximum kernel
# version to 0 makes dkms skip that kernel quietly - no build, no error, and
# other kernels that still need the module are unaffected.
#
# Ask the kernel's OWN ahci module.  Neither /proc/kallsyms nor
# updates/dkms/ahci.ko may be used: both would find our own module and answer
# the wrong question.  Compressed modules are not searched, in which case the
# build goes ahead and prepare.sh notices instead.
#
# Note that stdout of this file is discarded by dkms, hence stderr.
for _ahci in /lib/modules/$kernelver/kernel/drivers/ata/ahci.ko; do
	if [ -e "$_ahci" ] && grep -q ahci_mv_irq_handler "$_ahci"; then
		echo "ahci-mv: $kernelver already contains the 88SE6121 fix," \
		     "skipping - this package can be removed" >&2
		BUILD_EXCLUSIVE_KERNEL_MAX="0"
	fi
done

# No MAKE/CLEAN on purpose: dkms defaults to
#   make -C $kernel_source_dir M=$dkms_tree/$module/$module_version/build
# which is exactly right here.  Spelling it out with ${PWD} is a trap - the
# maintainer script runs with the working directory at /, so M= ends up as /.

BUILT_MODULE_NAME[0]="ahci"
DEST_MODULE_LOCATION[0]="/updates"

AUTOINSTALL="yes"
